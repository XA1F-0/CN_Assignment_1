{
  "info": {
    "name": "Research Opportunity Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests 1 to 10 in order. Start the backend first."
  },
  "item": [
    {
      "name": "1. Create opportunity #1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Federated Learning for Medical Imaging\",\n  \"description\": \"Train image models across hospitals without sharing patient data.\",\n  \"research_area\": \"Machine Learning\",\n  \"faculty_name\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, PyTorch, Statistics\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "if (!pm.collectionVariables.get('opportunityId')) { pm.collectionVariables.set('opportunityId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
